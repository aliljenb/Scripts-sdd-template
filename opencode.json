{
  "$schema": "https://opencode.ai/config.json",

  "instructions": [".opencode/rules/*.md"],

  "permissions": [
    { "action": "claude-in-chrome_*", "resource": "*", "effect": "deny" },
    { "action": "browser", "resource": "*", "effect": "deny" },

    { "action": "skill", "resource": "spec-new", "effect": "deny" },
    { "action": "skill", "resource": "spec-requirements", "effect": "deny" },
    { "action": "skill", "resource": "spec-design", "effect": "deny" },
    { "action": "skill", "resource": "spec-tasks", "effect": "deny" },
    { "action": "skill", "resource": "implement-task", "effect": "deny" },
    { "action": "skill", "resource": "review", "effect": "deny" },

    { "action": "read", "resource": "*specs/*prompt.txt", "effect": "deny" },
    { "action": "read", "resource": "*specs/*prompts.txt", "effect": "deny" }
  ],

  "agents": {
    "sdd-spec-new": {
      "description": "SDD: scaffolds a new specs/<feature-name>/ folder. Used by /spec-new.",
      "mode": "primary",
      "permissions": [
        { "action": "skill", "resource": "spec-new", "effect": "allow" },
        { "action": "edit", "resource": "*", "effect": "deny" },
        { "action": "edit", "resource": "*specs/*", "effect": "allow" },
        { "action": "shell", "resource": "*", "effect": "deny" }
      ]
    },

    "sdd-requirements": {
      "description": "SDD Requirements phase: may only write specs/<feature-name>/requirements.md. Used by /spec-requirements.",
      "mode": "primary",
      "permissions": [
        { "action": "skill", "resource": "spec-requirements", "effect": "allow" },
        { "action": "question", "resource": "*", "effect": "allow" },
        { "action": "edit", "resource": "*", "effect": "deny" },
        { "action": "edit", "resource": "*specs/*/requirements.md", "effect": "allow" },
        { "action": "shell", "resource": "*", "effect": "deny" }
      ]
    },

    "sdd-design": {
      "description": "SDD Design phase: may only write specs/<feature-name>/design.md and docs/domain/{glossary,bounded-contexts}.md. Used by /spec-design.",
      "mode": "primary",
      "permissions": [
        { "action": "skill", "resource": "spec-design", "effect": "allow" },
        { "action": "question", "resource": "*", "effect": "allow" },
        { "action": "edit", "resource": "*", "effect": "deny" },
        { "action": "edit", "resource": "*specs/*/design.md", "effect": "allow" },
        { "action": "edit", "resource": "*docs/domain/glossary.md", "effect": "allow" },
        { "action": "edit", "resource": "*docs/domain/bounded-contexts.md", "effect": "allow" },
        { "action": "shell", "resource": "*", "effect": "deny" }
      ]
    },

    "sdd-tasks": {
      "description": "SDD Tasks phase: may only write specs/<feature-name>/tasks.md. Used by /spec-tasks.",
      "mode": "primary",
      "permissions": [
        { "action": "skill", "resource": "spec-tasks", "effect": "allow" },
        { "action": "edit", "resource": "*", "effect": "deny" },
        { "action": "edit", "resource": "*specs/*/tasks.md", "effect": "allow" },
        { "action": "shell", "resource": "*", "effect": "deny" }
      ]
    },

    "sdd-implement": {
      "description": "SDD Implementation phase: implements tasks from an approved tasks.md. Used by /implement-task.",
      "mode": "primary",
      "permissions": [
        { "action": "skill", "resource": "implement-task", "effect": "allow" },
        { "action": "edit", "resource": "*", "effect": "allow" },
        { "action": "shell", "resource": "*", "effect": "ask" },
        { "action": "shell", "resource": "pytest *", "effect": "allow" },
        { "action": "shell", "resource": "ruff *", "effect": "allow" },
        { "action": "shell", "resource": "mypy *", "effect": "allow" },
        { "action": "shell", "resource": "git *", "effect": "allow" }
      ]
    },

    "sdd-review": {
      "description": "SDD Review phase: read-only audit of an implementation against its spec. Used by /review.",
      "mode": "primary",
      "permissions": [
        { "action": "skill", "resource": "review", "effect": "allow" },
        { "action": "edit", "resource": "*", "effect": "deny" },
        { "action": "shell", "resource": "*", "effect": "ask" },
        { "action": "shell", "resource": "pytest *", "effect": "allow" },
        { "action": "shell", "resource": "ruff *", "effect": "allow" },
        { "action": "shell", "resource": "mypy *", "effect": "allow" },
        { "action": "shell", "resource": "git diff *", "effect": "allow" },
        { "action": "shell", "resource": "git log *", "effect": "allow" }
      ]
    }
  }
}
